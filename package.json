{
  "name": "deepseekharness-acp-interactive",
  "version": "1.0.7",
  "description": "Editor-facing Agent Client Protocol (ACP) server for Zed and other ACP clients, composed from published DeepSeek Harness plugins.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ClickPM/dsh-acp-interactive.git"
  },
  "homepage": "https://github.com/ClickPM/dsh-acp-interactive#readme",
  "bugs": {
    "url": "https://github.com/ClickPM/dsh-acp-interactive/issues"
  },
  "type": "module",
  "bin": {
    "dsh-acp-interactive": "lib/bin.js"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./bin": "./lib/bin.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "config",
    "docs",
    "README.md",
    "README.zh.md"
  ],
  "scripts": {
    "build": "tsdown",
    "prepare": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && vitest run",
    "test:harness": "node scripts/test-harness.mjs",
    "test:all": "npm test && npm run test:harness && npm run check:profile",
    "check:profile": "node scripts/check-editor-profile.mjs",
    "check:registry": "node scripts/check-registry-entry.mjs",
    "verify:packed": "node scripts/verify-packed-install.mjs"
  },
  "keywords": [
    "ai-agent",
    "cordis",
    "deepseek",
    "deepseek-harness",
    "dsh-plugin",
    "acp",
    "agent-client-protocol",
    "zed"
  ],
