  ],
  "selections": [
    {
      "id": "model-generated-session-title",
      "decision": "selected",
      "reason": "The published first-prompt provider summarizes the first eligible human message through the exact logged model route, while the log-backed title service preserves the immediate deterministic fallback and ACP projects accepted revisions.",
      "requiredPackages": [
        "@deepseek-ai/dsh-session-title-first-prompt-llm",
        "@deepseek-ai/dsh-session-title-llm",
        "@deepseek-ai/dsh-session-title",
        "@deepseek-ai/dsh-llm"
      ]
    },
    {
      "id": "filesystem-search",
      "decision": "selected",
      "reason": "Packaged ripgrep provides cwd-scoped glob and grep without an external account; the tool owns presentation metadata and cooperatively observes cancellation.",
      "requiredPackages": [
        "@deepseek-ai/dsh-tool-fs-search",
        "@deepseek-ai/dsh-tool-call-timeout-policy",
        "@deepseek-ai/dsh-subprocess-local",
        "@deepseek-ai/dsh-tools",
        "@deepseek-ai/dsh-system-prompt"
      ]
    },
    {
      "id": "web",
      "decision": "selected",
      "reason": "DeepSeek web search provider is available with the user's API key; the model-facing web tool projects through the generic ACP card with cwd and cancellation isolation.",
      "requiredPackages": [
        "@deepseek-ai/dsh-web",
        "@deepseek-ai/dsh-web-fetch-http",
        "@deepseek-ai/dsh-web-search-deepseek",
        "@deepseek-ai/dsh-tool-web",
        "@deepseek-ai/dsh-tools"
      ]
    },
    {
      "id": "goal-command-and-tools",
      "decision": "selected",
      "reason": "This profile composes the persisted goal service, round driver, and model tool directly now that the upstream agent-spine example package is gone; command-goal is the matching human consumer discovered through ctx.commands.",
      "requiredPackages": [
        "@deepseek-ai/dsh-goal",
        "@deepseek-ai/dsh-goal-round-driver",
        "@deepseek-ai/dsh-tool-goal",
        "@deepseek-ai/dsh-command-goal",
        "@deepseek-ai/dsh-commands"
      ]
    },
    {
      "id": "generic-tool-projection",
      "decision": "selected",
      "reason": "All selected model tools remain registry-owned and project through presentCall, presentResult, and durable presentationMeta.",
      "requiredPackages": [
        "@deepseek-ai/dsh-tools"
      ]
    },
    {
      "id": "session-scoped-mcp",
      "decision": "selected",
      "reason": "ACP request configuration is mapped into a private per-session Cordis host while every discovered tool registration delegates to the exact agent-scoped Harness tool registry.",
      "requiredPackages": [
        "@deepseek-ai/dsh-mcp-client",
        "@deepseek-ai/dsh-subprocess",
        "@deepseek-ai/dsh-timeout",
        "@deepseek-ai/dsh-tools"
      ]
    }
  ],
  "deferred": [
    {
      "id": "lsp",
      "reason": "Language-server discovery and per-session process teardown require a separate explicit review.",
      "excludedCompositionPackages": ["@deepseek-ai/dsh-lsp", "@deepseek-ai/dsh-lsp-stdio"]
    },
    {
      "id": "persistent-terminal",
      "reason": "Incremental output, settlement, and teardown adaptation are not part of this profile revision.",
      "excludedCompositionPackages": ["@deepseek-ai/dsh-terminal", "@deepseek-ai/dsh-terminal-bash"]
    },
    {
      "id": "subagent-and-workflow",
      "reason": "Child settlement, late-event suppression, cancellation, and connection teardown need dedicated ACP coverage before inclusion.",
      "excludedCompositionPackages": [
        "@deepseek-ai/dsh-subagent",
        "@deepseek-ai/dsh-tool-subagent",
        "@deepseek-ai/dsh-tool-workflow",
        "@deepseek-ai/dsh-workflow-worker-thread"
      ]
    }
  ],
  "reconciliation": {
    "referenceFiles": [
      "packages/bundle/base/cordis.patch.yml",
      "packages/preset/agent-presets/presets/standard/agent.cordis.yml"
    ],
    "candidatePatterns": [
      "^@deepseek-ai/dsh-(?:(?:command-.+)|permission-presets$|plan-mode$|skill-filesystem$|goal(?:-.+)?$|jobs-local$|web(?:-.+)?$|lsp(?:-.+)?$|terminal(?:-.+)?$|subagent(?:-.+)?$|workflow(?:-.+)?$|spill(?:-.+)?$|compaction-tool-result-pruner$|tool-(?:fs-search|goal|jobs|web|ralph|subagent(?:-.+)?|workflow)$|tool-call-timeout-policy$)"
    ],
    "providerPatterns": [
      "^@deepseek-ai/dsh-(?:skill-filesystem$|goal(?:-.+)?$|jobs-local$|web(?:-.+)?$|lsp(?:-.+)?$|terminal(?:-.+)?$|subagent(?:-.+)?$|workflow(?:-.+)?$|spill(?:-.+)?$|compaction-tool-result-pruner$|tool-call-timeout-policy$)"
    ],
    "consumerPatterns": [
      "^@deepseek-ai/dsh-(?:command-.+|permission-presets$|plan-mode$|tool-(?:fs-search|goal|jobs|web|ralph|subagent(?:-.+)?|workflow)$)"
    ],
